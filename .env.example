# --- Form notifications (optional — forms work without these, submissions
# --- are logged to the server console until configured) ---

# Resend API key (free tier: resend.com — 3,000 emails/month)
RESEND_API_KEY=

# Where contact & career form submissions are delivered.
# NOTE: without a verified domain in Resend, delivery only works to the
# email address you signed up to Resend with.
NOTIFY_EMAIL=

# Sender address. Default works without any domain setup.
# Once you verify your own domain in Resend, change to e.g.
# "Magle Digital <hello@magle.digital>"
NOTIFY_FROM="Magle Digital <onboarding@resend.dev>"
